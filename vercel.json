{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "cd frontend && npm install --ignore-scripts=false && node ./node_modules/vite/bin/vite.js build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/gastos(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/categorias(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/reportes(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
